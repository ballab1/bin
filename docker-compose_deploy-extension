#!/bin/bash

declare dc_file
declare COMPOSE_YAML='docker-compose.yml'

declare wsdir="workspace.$(basename "$(pwd)")"
if [[ $(IFS=' ' echo $* | grep -cE ' -f|--file ') -eq 0 && -h deploy && -d "$wsdir" && -f "${wsdir}/$COMPOSE_YAML" ]]; then
   [ -e ${wsdir}/.env ] && source ${wsdir}/.env 2>/dev/null
   dc_file="-f ${wsdir}/$COMPOSE_YAML"
fi
docker compose ${dc_file:-} "$@"
